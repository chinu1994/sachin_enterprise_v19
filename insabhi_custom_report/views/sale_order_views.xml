<?xml version="1.0" encoding="utf-8"?>
<odoo>

    <record id="group_remove_bom_restriction" model="res.groups">
        <field name="name">Remove BoM Restriction</field>
    </record>
    <record id="view_sale_order_form_inherit_terms" model="ir.ui.view">
        <field name="name">sale.order.form.inherit.terms</field>
        <field name="model">sale.order</field>
        <field name="inherit_id" ref="sale.view_order_form"/>
        <field name="arch" type="xml">
            <xpath expr="//field[@name='note']" position="after">
                <field name="insabhi_term_condition" widget="html"/>
            </xpath>
            <field name="payment_term_id" position="after">
                <field name="delivery_days"/>
            </field>
             <xpath expr="//field[@name='order_line']//list//field[@name='product_uom_qty']"
                   position="before">

                <field name="bom_id"/>

            </xpath>
             <xpath expr="//page[@name='other_information']//field[@name='client_order_ref']"
               position="after">
            <field name="bom_restrictions_remove"
                   groups="insabhi_custom_report.group_remove_bom_restriction"/>
        </xpath>
        </field>
    </record>


</odoo>